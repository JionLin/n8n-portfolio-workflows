# Copy to .env and fill in real values locally. Never commit .env.
# Every value below is a placeholder.

# n8n core
N8N_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32
GENERIC_TIMEZONE=UTC

# 01 Lead capture
LEAD_SHEET_ID=replace-with-google-sheet-id
SLACK_CHANNEL='#leads'
NOTIFY_EMAIL=you@example.com

# 02 Email AI triage: any OpenAI-compatible Chat Completions endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=replace-with-model-name
GMAIL_LABEL_IDS_JSON='{"billing":"replace-label-id","technical_support":"replace-label-id","sales_inquiry":"replace-label-id","spam":"replace-label-id","other":"replace-label-id"}'

# 03 SupportPilot bridge (from inside the n8n container, use host.docker.internal)
SUPPORTPILOT_BASE_URL=http://host.docker.internal:8000
