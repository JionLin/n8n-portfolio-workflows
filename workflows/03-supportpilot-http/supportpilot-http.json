        "authentication": "none",
        "options": {
          "timeout": 10000
        }
      },
      "id": "d3000008-0000-4000-8000-000000000100",
      "name": "GET SupportPilot /api/health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [220, 620]
    },
    {
      "parameters": {
        "content": "## 03 SupportPilot HTTP bridge\n\nCalls `POST /api/chat` with the non-streaming JSON path. Request body: `message` (1..4000 characters) and optional `conversation_id` (UUID or null). SSE is not used because the HTTP Request node buffers the whole response body.\n\nRequired env var: `SUPPORTPILOT_BASE_URL`. Inside Docker use `http://host.docker.internal:8000`, not `127.0.0.1`.\n\nThe response is the AgentReply JSON, passed through unchanged, and includes `conversation_id`.",
        "height": 300,
        "width": 440,
        "color": 4
      },
      "id": "d3000009-0000-4000-8000-000000000100",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -120]
    }
  ],
