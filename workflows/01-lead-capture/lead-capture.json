{
  "name": "01 - Lead capture (webhook to Google Sheets, Slack, email)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000001",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [0, 300],
      "webhookId": "a1000001-0000-4000-8000-000000000101"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1000002-0000-4000-8000-000000000001",
              "name": "name",
              "value": "={{ String($json.body.name ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "a1000002-0000-4000-8000-000000000002",
              "name": "email",
              "value": "={{ String($json.body.email ?? '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "a1000002-0000-4000-8000-000000000003",
              "name": "company",
              "value": "={{ String($json.body.company ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "a1000002-0000-4000-8000-000000000004",
              "name": "message",
              "value": "={{ String($json.body.message ?? '').trim().slice(0, 2000) }}",
              "type": "string"
            },
            {
              "id": "a1000002-0000-4000-8000-000000000005",
              "name": "source",
              "value": "={{ $json.body.source ?? 'webhook' }}",
              "type": "string"
            },
            {
              "id": "a1000002-0000-4000-8000-000000000006",
              "name": "received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000002-0000-4000-8000-000000000100",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1000003-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.email }}",
              "rightValue": "@",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "a1000003-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000003-0000-4000-8000-000000000100",
      "name": "Email Looks Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [440, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"rejected\", \"reason\": \"name_or_email_invalid\" }",
        "options": {
          "responseCode": 400
        }
      },
      "id": "a1000004-0000-4000-8000-000000000100",
      "name": "Reject Invalid Lead",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [660, 460]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.LEAD_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "received_at": "={{ $json.received_at }}",
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "company": "={{ $json.company }}",
            "message": "={{ $json.message }}",
            "source": "={{ $json.source }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1000005-0000-4000-8000-000000000100",
      "name": "Append to Leads Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [660, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"accepted\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1000006-0000-4000-8000-000000000100",
      "name": "Accept Lead",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [900, 120]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $env.SLACK_CHANNEL }}"
        },
        "text": "=New lead: {{ $('Normalize Lead').item.json.name }} <{{ $('Normalize Lead').item.json.email }}> from {{ $('Normalize Lead').item.json.company || 'unknown company' }}",
        "otherOptions": {}
      },
      "id": "a1000007-0000-4000-8000-000000000100",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [900, 300],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Slack account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $env.NOTIFY_EMAIL }}",
        "subject": "=New lead: {{ $('Normalize Lead').item.json.name }}",
        "emailType": "text",
        "message": "=Source: {{ $('Normalize Lead').item.json.source }}\nEmail: {{ $('Normalize Lead').item.json.email }}\nCompany: {{ $('Normalize Lead').item.json.company }}\n\n{{ $('Normalize Lead').item.json.message }}",
        "options": {}
      },
      "id": "a1000008-0000-4000-8000-000000000100",
      "name": "Email Notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1120, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "content": "## 01 Lead capture\n\nImport this file, then attach credentials to the Google Sheets, Slack and Gmail nodes.\n\nRequired env vars: `LEAD_SHEET_ID`, `SLACK_CHANNEL`, `NOTIFY_EMAIL`.\n\nSheet tab `Leads` needs headers: received_at, name, email, company, message, source.\n\nRetries: Sheets, Slack and Gmail nodes retry 3 times. The webhook itself does not retry; callers must.\n\nError Trigger: import `error-handler.json` and select it under workflow Settings > Error workflow.",
        "height": 340,
        "width": 420,
        "color": 4
      },
      "id": "a1000009-0000-4000-8000-000000000100",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-120, -60]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [
        [
          {
            "node": "Normalize Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Lead": {
      "main": [
        [
          {
            "node": "Email Looks Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Looks Valid?": {
      "main": [
        [
          {
            "node": "Append to Leads Sheet",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Invalid Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append to Leads Sheet": {
      "main": [
        [
          {
            "node": "Accept Lead",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Slack": {
      "main": [
        [
          {
            "node": "Email Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "active": false
}
