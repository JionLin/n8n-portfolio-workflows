      "id": "c2000004-0000-4000-8000-000000000100",
      "name": "Normalize Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [440, 250]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_BASE_URL }}/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.LLM_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.LLM_MODEL, temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Classify the email for a small support and sales inbox. Reply only with a JSON object with keys: category (billing | technical_support | sales_inquiry | spam | other), priority (low | medium | high), needs_reply (boolean), suggested_label (same values as category), draft_reply (string, a draft for human review, no prices or promises), summary (string, at most 25 words).' }, { role: 'user', content: 'Subject: ' + $json.subject + '\\n\\n' + $json.body } ] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "c2000005-0000-4000-8000-000000000100",
      "name": "Classify with LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [660, 250],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ALLOWED_CATEGORIES = ['billing', 'technical_support', 'sales_inquiry', 'spam', 'other'];\nconst ALLOWED_PRIORITIES = ['low', 'medium', 'high'];\n\nfunction parseModelReply(rawContent) {\n  try {\n    return JSON.parse(rawContent);\n  } catch (error) {\n    return null;\n  }\n}\n\nfunction isValidReply(reply) {\n  return reply !== null\n    && typeof reply === 'object'\n    && ALLOWED_CATEGORIES.includes(reply.category)\n    && ALLOWED_PRIORITIES.includes(reply.priority);\n}\n\nfunction readLabelIdsByCategory() {\n  try {\n    return JSON.parse($env.GMAIL_LABEL_IDS_JSON || '{}');\n  } catch (error) {\n    return {};\n  }\n}\n\nfunction buildTriageResult(reply, sourceEmail) {\n  const hasValidReply = isValidReply(reply);\n  const category = hasValidReply ? reply.category : 'other';\n  const labelIdsByCategory = readLabelIdsByCategory();\n\n  return {\n    email_id: sourceEmail.email_id,\n    thread_id: sourceEmail.thread_id,\n    from: sourceEmail.from,\n    subject: sourceEmail.subject,\n    category,\n    priority: hasValidReply ? reply.priority : 'medium',\n    needs_reply: hasValidReply && reply.needs_reply === true,\n    draft_reply: hasValidReply && typeof reply.draft_reply === 'string' ? reply.draft_reply : '',\n    summary: hasValidReply && typeof reply.summary === 'string' ? reply.summary : '',\n    gmail_label_id: labelIdsByCategory[category] ?? null,\n    needs_human_review: !hasValidReply\n  };\n}\n\nconst rawContent = $json.choices?.[0]?.message?.content ?? '';\nconst reply = parseModelReply(rawContent);\nconst sourceEmail = $('Normalize Email').item.json;\n\nreturn { json: buildTriageResult(reply, sourceEmail) };"
      },
      "id": "c2000006-0000-4000-8000-000000000100",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 250]
